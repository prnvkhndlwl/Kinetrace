# Line endings: shell scripts must stay LF (bash on Linux / macOS rejects CRLF),
# Windows batch files CRLF; everything else is normalised by git.
* text=auto
*.sh text eol=lf
*.command text eol=lf
*.bat text eol=crlf
*.yml text eol=lf
*.py text
*.md text
*.txt text
*.json text
*.png binary
*.mp4 binary
*.npz binary
